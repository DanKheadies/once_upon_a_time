{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "once-upon-a-time-site",
          "appId": "1:798258104215:android:f905147f2027005267a6d2",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "once-upon-a-time-site",
          "appId": "1:798258104215:ios:5f965caf32113c8a67a6d2",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "once-upon-a-time-site",
          "configurations": {
            "android": "1:798258104215:android:f905147f2027005267a6d2",
            "ios": "1:798258104215:ios:5f965caf32113c8a67a6d2",
            "web": "1:798258104215:web:aad3dd4eb89fa90867a6d2"
          }
        }
      }
    }
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ]
}
